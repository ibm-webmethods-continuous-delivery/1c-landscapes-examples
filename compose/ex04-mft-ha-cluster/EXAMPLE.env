EX04_HA_PORT_PREFIX=444

########## Images we use in this landscape example
## Database
EX04_HA_POSTGRES_IMAGE=postgres:18
## MFT Database Component Configurator (DCC)
EX04_HA_DBC_IMAGE=ibmwebmethods.azurecr.io/webmethods-activetransfer-dcc:11.1.0.4
## MFT AT Product
EX04_HA_MFT_IMAGE=ibmwebmethods.azurecr.io/webmethods-activetransfer:11.1.0.4

########## Configuration depending on the above images
## Database
# use docker inspect ${EX04_HA_POSTGRES_IMAGE} to determine the correct mountpoint value
EX04_HA_POSTGRES_DATA_MOUNT_POINT=/var/lib/postgresql
# Provided default user to the DB
EX04_HA_POSTGRES_USER=postgres
EX04_HA_POSTGRES_PASS='Pas,sword1'
# We create two different other application users
EX04_HA_WM_DB_NAME=webmethods
EX04_HA_WM_DB_USER_NAME=webmethods
EX04_HA_WM_DB_USER_PASS='Pas,sword2'

EX04_HA_WM_ARCHIVE_DB_NAME=wmarchive
EX04_HA_WM_ARCHIVE_DB_USER_NAME=wmarchive
EX04_HA_WM_ARCHIVE_DB_USER_PASS='Pas,sword3'

## MFT DCC
# Path valid for EX04_HA_DBC_IMAGE=ibmwebmethods.azurecr.io/webmethods-activetransfer-dcc:11.1.0.*
EX04_HA_DBC_WM_HOME=/opt/softwareag
# Would like logs to survive container destruction
EX04_HA_DBC_LOGS_MOUNT_POINT=${EX04_HA_DBC_WM_HOME}/common/db/logs
# Decision - where to mount our initialization scripts
EX04_HA_DBC_SCRIPTS_MOUNT_POINT=/mnt/scripts

# Certificate Manager
# Passphrase for encrypting/decrypting private keys
# WARNING: For testing only. In production, use a proper secrets manager.
EX04_HA_TEST_PK_SECRET=TestOnly123

# # Test Double Credentials (legacy - kept for backward compatibility)
# EX04_HA_TEST_FTP_USER=ftpuser
# EX04_HA_TEST_FTP_PASS=FtpPass123!
# EX04_HA_TEST_SFTP_USER=sftpuser
# EX04_HA_TEST_SFTP_PASS=SftpPass123!
